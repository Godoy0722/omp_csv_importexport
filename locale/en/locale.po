msgid "plugins.importexport.csv.displayName"
msgstr "CSV Import Plugin"

msgid "plugins.importexport.csv.description"
msgstr "Import monographs or users through a CSV file."

msgid "plugins.importexport.csv.cliUsage"
msgstr "Command-line tool for importing monographs or users through a CSV file.\n"
"Usage:\n"
"{$scriptName} {$pluginName} [--dry-mode] [monographs|users] username pathToCsvDir [--sendWelcomeEmail]\n"
"Choose one of the following options:\n"
" - monographs - import monographs from CSV file\n"
" - users - import users from CSV file\n\n"
"username - the username of the user to whom imported monographs should be assigned.\n"
"pathToCsvDir - the path to the directory containing the CSV file(s) to be imported.\n"
"--sendWelcomeEmail - optional flag, if set, a welcome email will be sent to imported users.\n"
"--dry-mode - optional flag, validates the CSV data without persisting any changes to the database."

msgid "plugins.importexport.csv.cliUsage.examples"
msgstr "Examples:\n"
"{$scriptName} {$pluginName} monographs admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} users admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} users admin /home/user/import_files/ --sendWelcomeEmail\n"
"{$scriptName} {$pluginName} --dry-mode monographs admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} --dry-mode users admin /home/user/import_files/"

msgid "plugins.importexport.csv.unknownUser"
msgstr "Unknown User: \"{$username}\". Exiting."

msgid "plugins.importexport.csv.unknownSourceDir"
msgstr "Invalid source dir: \"{$sourceDir}\". Please verify this param on CLI. Exiting."

msgid "plugins.importexport.csv.unknownPress"
msgstr "Unknown Press: \"{$contextPath}\". Skipping."

msgid "plugins.importexport.csv.couldNotCreateFile"
msgstr "Could not create the file \"{$filename}\"."

msgid "plugins.importexport.csv.invalidArticleFile"
msgstr "Invalid monograph file for this submission."

msgid "plugins.importexport.csv.fileProcessFinished"
msgstr "Process for file \"{$filename}\" finished. {$createdRows} created, {$updatedRows} updated, {$failedRows} failed."

msgid "plugins.importexport.csv.invalidBookCoverImage"
msgstr "The cover image has an invalid format for this row."

msgid "plugins.importexport.csv.erroWhileSavingBookCoverImage"
msgstr "The cover image \"{$filename}\" could not be saved."

msgid "plugins.importexport.csv.errorWhileSavingSubmissionFile"
msgstr "The file \"{$filename}\" could not be saved: {$message}."

msgid "plugins.importexport.csv.errorWhileSavingSupplementaryFile"
msgstr "An error occurred while saving the supplementary file {$file}."

msgid "plugins.importexport.csv.errorWhileSavingSubmissionGalley"
msgstr "An error occurred while saving the galley {$galley}."

msgid "plugins.importexport.csv.baseRowFailedForIdentifier"
msgstr "The base row for identifier \"{$identifier}\" failed validation. This row depends on it and cannot be processed."

msgid "plugins.importexport.csv.invalidCommand"
msgstr "Invalid command: \"{$command}\". Supported commands: monographs, users."

msgid "plugins.importexport.csv.form.importType.monographs"
msgstr "Monographs"

msgid "plugins.importexport.csv.form.zipHelp"
msgstr "<b>Monographs:</b> Upload a single monographs CSV, or a ZIP that contains the CSV file(s) and the files they reference. The ZIP must have one of these two layouts:<br><br><b>Option 1 — Everything at the top level:</b> the CSV files and their assets (PDFs, images and other files) sit directly at the top level of the ZIP.<br><br><b>Option 2 — Everything in one folder:</b> the CSV files and their assets sit inside exactly one top-level folder.<br><br>Any other layout (CSV files nested deeper, or spread over several top-level folders) is rejected. <em>__MACOSX</em> and folders whose names start with a dot are ignored. The file path you write in each CSV column must match where the file sits relative to the CSV (e.g., <em>galleys/monograph.pdf</em>). Files named <em>invalid_*.csv</em> are reserved for error output and are skipped during import. <a href=\"https://github.com/Godoy0722/omp_csv_importexport/blob/stable-3_5_0/docs/csv-format.md#import-file-structure\" target=\"_blank\" rel=\"noopener noreferrer\">Click here to see the import file structure</a>."

msgid "plugins.importexport.csv.form.examplesHelp"
msgstr "<b>Need an example?</b> You can view and download ready-to-use sample CSV files here: <a href=\"https://github.com/Godoy0722/omp_csv_importexport/tree/stable-3_5_0/examples/monographs\" target=\"_blank\" rel=\"noopener noreferrer\">CSV examples</a>."

msgid "plugins.importexport.csv.form.userImportHelp"
msgstr "<b>Users:</b> Upload a single users CSV, or a ZIP when you have more than one file. Your CSV file should include columns such as pressPath, firstname, lastname, email, roles, and optional fields like affiliation, country, username, tempPassword, reviewInterests, and orcid. Enable the welcome email option to automatically notify new users of their account creation. <a href=\"https://github.com/Godoy0722/omp_csv_importexport/blob/stable-3_5_0/docs/csv-format.md#users-csv-format\" target=\"_blank\" rel=\"noopener noreferrer\">Click here to see how to fill the CSV file</a>."

msgid "plugins.importexport.csv.form.usersExamplesHelp"
msgstr "<b>Need an example?</b> You can view and download ready-to-use sample user CSV files here: <a href=\"https://github.com/Godoy0722/omp_csv_importexport/tree/stable-3_5_0/examples/users\" target=\"_blank\" rel=\"noopener noreferrer\">CSV examples for users</a>."

msgid "plugins.importexport.csv.results.intro.monographs"
msgstr "This is the result of importing <b>monographs</b>. Every row of your CSV files was processed: rows that succeeded were saved to the press, and any that failed are listed further down together with the reason they could not be imported."

msgid "plugins.importexport.csv.results.intro.monographs.dryMode"
msgstr "This is a <b>Data Validation</b> for <b>monographs</b> — nothing was saved to the press. The summary below is a preview of what a real import would do: it shows which rows would be created and which would fail, along with the reason for each failure. When you are happy with the result, disable <b>Data Validation</b> and import again to apply the changes."

msgid "plugins.importexport.csv.duplicateDoi"
msgstr "The DOI \"{$doi}\" already exists in this press."

