msgid "plugins.importexport.csv.displayName"
msgstr "CSV Import Plugin"

msgid "plugins.importexport.csv.description"
msgstr "Import monographs or users through a CSV file."

msgid "plugins.importexport.csv.cliUsage"
msgstr "Command-line tool for importing monographs or users through a CSV file.\n"
"Usage:\n"
"{$scriptName} {$pluginName} [--dry-mode] [monographs|users] username pathToCsvDir [--sendWelcomeEmail]\n"
"Choose one of the following options:\n"
" - monographs - import monographs from CSV file\n"
" - users - import users from CSV file\n\n"
"username - the username of the user to whom imported monographs should be assigned.\n"
"pathToCsvDir - the path to the directory containing the CSV file(s) to be imported.\n"
"--sendWelcomeEmail - optional flag, if set, a welcome email will be sent to imported users.\n"
"--dry-mode - optional flag, validates the CSV data without persisting any changes to the database."

msgid "plugins.importexport.csv.cliUsage.examples"
msgstr "Examples:\n"
"{$scriptName} {$pluginName} monographs admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} users admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} users admin /home/user/import_files/ --sendWelcomeEmail\n"
"{$scriptName} {$pluginName} --dry-mode monographs admin /home/user/import_files/\n"
"{$scriptName} {$pluginName} --dry-mode users admin /home/user/import_files/"

