msgstr "{$field} has a value at position {$position}, but chapterTitle is empty at that position."

msgid "plugins.importexport.csv.chapterFieldHasMorePositions"
msgstr "{$field} has {$count} positions, but chapterTitle has {$expected}. In chapterContributors, \"#\" separates the chapters."

msgid "plugins.importexport.csv.errorWhileSavingChapterFile"
msgstr "The chapter file \"{$filename}\" could not be saved: {$message}."

msgid "plugins.importexport.csv.invalidChapterFile"
msgstr "Missing chapter file \"{$filename}\" for this submission."

msgid "plugins.importexport.csv.invalidChapterContributor"
msgstr "The chapter contributor \"{$contributor}\" does not match any author in the authors column."
